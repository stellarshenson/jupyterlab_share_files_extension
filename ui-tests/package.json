{
  "name": "@stellarshenson/jupyterlab-share-files-extension-ui-tests",
  "version": "1.0.0",
  "description": "JupyterLab @stellarshenson/jupyterlab-share-files-extension Integration Tests",
  "private": true,
  "scripts": {
    "start": "jupyter lab --config jupyter_server_test_config.py",
    "test": "jlpm playwright test",
    "test:update": "jlpm playwright test --update-snapshots",
    "test:hub": "jlpm playwright test -c playwright.hub.config.js",
    "test:livehub": "jlpm playwright test -c playwright.livehub.config.js"
  },
  "devDependencies": {
    "@jupyterlab/galata": "^5.6.4",
    "@playwright/test": "^1.64.0"
  }
}
